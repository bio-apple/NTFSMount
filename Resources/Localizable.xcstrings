    "help.unmount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmounts this app’s writable mount; the disk stays connected. Use Eject before unplugging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载本应用的可写挂载；磁盘仍连接，需要拔线请用「推出」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卸載本 App 的可寫掛載；磁碟仍連接，需要拔線請用「推出」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの書き込み可能マウントを解除します。ディスクは接続されたままです。抜く前は「取り出す」を使ってください。"
          }
        }
      }
    },
    "help.eject": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject unmounts first, then pops the disk out. Unplug after it disappears from Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推出会先卸载再弹出，访达里消失后再拔线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推出會先卸載再彈出，Finder 裡消失後再拔線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り出すと先にアンマウントしてからディスクを排出します。Finder から消えてから抜いてください。"
          }
        }
      }
    },
