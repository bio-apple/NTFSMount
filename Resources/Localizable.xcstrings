    "window.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this window keeps the menu-bar NTFS icon. Use Eject to remove a disk. Do not Quit from the Dock if you want the icon to stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口后，菜单栏的 NTFS 图标仍会保留。要取下磁盘请用「推出」。若希望图标继续显示，请不要从程序坞退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗後，選單列的 NTFS 圖示仍會保留。要取下磁碟請用「推出」。若希望圖示繼續顯示，請不要從 Dock 結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィンドウを閉じても、メニューバーの NTFS アイコンは残ります。ディスクを取り外すときは「取り出す」を使ってください。アイコンを残したい場合は、Dock から終了しないでください。"
          }
        }
      }
    },
    "window.emptySubtitleNeedHelper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writable mount and format need the helper. After it is installed, plug in a Windows-formatted disk — it will appear on the left."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可写挂载和格式化需要助手。安装后再插入 Windows 格式的移动盘，它会出现在左侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可寫掛載與格式化需要助手。安裝後再插入 Windows 格式的行動碟，它會出現在左側。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みマウントとフォーマットにはヘルパーが必要です。インストール後に Windows 形式のディスクを接続すると、左側に表示されます。"
          }
        }
      }
    },
    "window.emptyTitleNeedHelper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the mount helper first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先安装挂载助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先安裝掛載助手"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にマウントヘルパーをインストールしてください"
          }
        }
      }
    },
    "window.helperMissingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writable mount and format need the mount helper. Choose Install… and enter the administrator password. Diagnose does not install it for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可写挂载和格式化需要挂载助手。点「安装…」并输入管理员密码；诊断不会自动安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可寫掛載與格式化需要掛載助手。點「安裝…」並輸入管理員密碼；診斷不會自動安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みマウントとフォーマットにはマウントヘルパーが必要です。「インストール…」を押し、管理者パスワードを入力してください。診断では自動インストールしません。"
          }
        }
      }
    },
    "window.helperUpdateDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writable mount and format need the current helper. Choose Update… and enter the administrator password. Nothing is installed automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可写挂载和格式化需要最新助手。点「更新…」并输入管理员密码；不会自动安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可寫掛載與格式化需要最新助手。點「更新…」並輸入管理員密碼；不會自動安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みマウントとフォーマットには最新のヘルパーが必要です。「更新…」を押し、管理者パスワードを入力してください。自動ではインストールしません。"
