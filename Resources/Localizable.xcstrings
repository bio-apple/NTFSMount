      }
    },
    "compat.belowMin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app supports only Apple Silicon (M-series) and macOS 13.0+. Intel Macs (x86_64) are not supported. This system is below macOS 13, untested; mounting may fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用仅支持 Apple Silicon（M 芯片）与 macOS 13.0+，不支持 Intel Mac（x86_64）。当前系统低于 macOS 13，未测试，挂载可能失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 僅支援 Apple Silicon（M 晶片）與 macOS 13.0+，不支援 Intel Mac（x86_64）。目前系統低於 macOS 13，未測試，掛載可能失敗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは Apple Silicon（M チップ）と macOS 13.0 以降のみ対応で、Intel Mac（x86_64）は非対応です。このシステムは macOS 13 未満で未検証のため、マウントに失敗する可能性があります。"
          }
        }
      }
    },
    "compat.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon (M-series) and macOS 13.0+ only. Intel Macs (x86_64) are not supported. This app does not use kernel extensions. From macOS 13 Ventura, kexts are more restricted, so it uses userspace FUSE (ntfs-3g + FUSE-T). If you see FSKit/module not enabled, ignore it — the helper already prefers NFS/userspace. Do not install a kernel extension."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持 Apple Silicon（M 芯片）与 macOS 13.0+，不支持 Intel Mac（x86_64）。本应用不使用内核扩展。macOS 13 Ventura 起对 kext 限制更严，因此使用用户态 FUSE（ntfs-3g + FUSE-T）。若提示 FSKit/模块未启用，可忽略——助手已优先使用 NFS/用户态路径，请勿安装内核扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支援 Apple Silicon（M 晶片）與 macOS 13.0+，不支援 Intel Mac（x86_64）。本 App 不使用核心延伸模組。macOS 13 Ventura 起對 kext 限制更嚴，因此使用使用者態 FUSE（ntfs-3g + FUSE-T）。若提示 FSKit／模組未啟用，可忽略——助手已優先使用 NFS／使用者態路徑，請勿安裝核心延伸模組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon（M チップ）と macOS 13.0 以降のみ対応。Intel Mac（x86_64）は非対応です。このアプリはカーネル拡張を使いません。macOS 13 Ventura 以降は kext の制限が厳しいため、ユーザ空間 FUSE（ntfs-3g + FUSE-T）を使います。FSKit／モジュールが無効と出ても無視してください。ヘルパーはすでに NFS／ユーザ空間経路を優先します。カーネル拡張を入れないでください。"
          }
        }
      }
    },
