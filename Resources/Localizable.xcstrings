    "alert.uninstallBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the privileged daemon and auto-mount on insert. The app stays in Applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除特权守护进程和插入时自动挂载。应用仍留在「应用程序」里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除特權守護程式和插入時自動掛載。App 仍留在「應用程式」裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特権デーモンと接続時の自動マウントを削除します。アプリは「アプリケーション」に残ります。"
          }
        }
      }
    },
    "alert.uninstall": {
      "extractionState": "manual",
      "localizations": {
