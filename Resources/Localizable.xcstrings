    "about.unnotarized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build is not notarized (Gatekeeper may block it). Control-click the app → Open; or click “Open Anyway” in System Settings → Privacy & Security."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前构建未公证（Gatekeeper 可能拦截）。按住 Control 点应用 → 打开；也可在「系统设置 → 隐私与安全性」点「仍要打开」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前建置未公證（Gatekeeper 可能攔截）。按住 Control 點 App → 打開；也可在「系統設定 → 隱私權與安全性」點「仍要打開」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドは未公証です（Gatekeeper にブロックされることがあります）。Control クリック → 開く。または「システム設定 → プライバシーとセキュリティ」で「このまま開く」。"
          }
        }
      }
    },
    "dirty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to repair the dirty volume?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试修复脏卷？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試修復髒卷？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーティボリュームの修復を試しますか？"
          }
        }
      }
    },
    "dirty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was not shut down cleanly or used Fast Startup, so the volume is marked dirty.\nntfsfix can only do a basic repair and may drop Windows cache that was not written to disk. Back up first.\nThis will not clear the Windows hibernation file. If this disk is hibernated, fully shut down Windows and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」未正常关机或处于快速启动，卷标记为不干净。\nntfsfix 只能做基本修复，可能丢失尚未写入磁盘的 Windows 缓存。请先备份。\n不会清除 Windows 休眠文件。若这是休眠盘，请在 Windows 彻底关机后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」未正常關機或處於快速啟動，卷標記為不乾淨。\nntfsfix 只能做基本修復，可能遺失尚未寫入磁碟的 Windows 快取。請先備份。\n不會清除 Windows 休眠檔。若這是休眠碟，請在 Windows 徹底關機後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は正常にシャットダウンされていないか、高速スタートアップのため、ボリュームがダーティとマークされています。\nntfsfix は基本的な修復だけを行い、ディスクに書き込まれていない Windows キャッシュが失われることがあります。先にバックアップしてください。\nWindows の休止ファイルは消しません。休止中のディスクなら、Windows を完全にシャットダウンしてから再試行してください。"
          }
        }
      }
    },
