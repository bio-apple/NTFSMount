    "encrypted.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possibly encrypted — do not write or format. macOS cannot confirm BitLocker; missing clues are not a negative result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能加密，勿写入/勿格式化。macOS 无法确认 BitLocker；未见线索不是阴性证明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能加密，勿寫入／勿格式化。macOS 無法確認 BitLocker；未見線索不是陰性證明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化の可能性あり。書き込み／フォーマットしないでください。macOS は BitLocker を確認できません。手がかりがないことは陰性証明ではありません。"
          }
        }
      }
    },
    "settings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
