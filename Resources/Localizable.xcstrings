          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抹掉「%@」并格式化为 NTFS？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抹掉「%@」並格式化為 NTFS？"
          }
