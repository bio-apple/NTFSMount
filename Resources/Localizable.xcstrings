    "format.confirmExtra": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every file on the disk and cannot be undone.\nIn “Type the current name” below, enter “%@” exactly. “New volume name” is the name after formatting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除盘上全部文件，且无法恢复。\n请在下方「输入当前名称」原样输入「%@」；「新卷名」为格式化后的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除碟上全部檔案，且無法復原。\n請在下方「輸入目前名稱」原樣輸入「%@」；「新卷名」為格式化後的名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上のすべてのファイルが削除され、元に戻せません。\n下の「現在の名前を入力」に「%@」をそのまま入力してください。「新しいボリューム名」はフォーマット後の名前です。"
          }
        }
      }
    },
