    "alert.updateHelperBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update is required for formatting, auto-mount on insert, and other new features. macOS will ask for an administrator password once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新才能使用格式化、插入时自动挂载等新功能。将请求一次管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新才能使用格式化、插入時自動掛載等新功能。將要求一次管理員密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットや接続時の自動マウントなど新機能を使うには更新が必要です。管理者パスワードを一度求めます。"
          }
        }
      }
    },
