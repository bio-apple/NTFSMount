    "alert.kextBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FSKit/kernel extensions being unavailable is expected on macOS 13+. You can ignore it. This app does not use kernel extensions; the helper prefers NFS/userspace FUSE. Do not install a kext.\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FSKit/内核扩展不可用是 macOS 13+ 的预期情况，可忽略。本应用不使用内核扩展，助手已优先使用 NFS/用户态 FUSE。请勿安装 kext。\n\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FSKit／核心延伸模組不可用是 macOS 13+ 的預期情況，可忽略。本 App 不使用核心延伸模組，助手已優先使用 NFS／使用者態 FUSE。請勿安裝 kext。\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 13 以降で FSKit／カーネル拡張が使えないのは想定どおりで、無視して構いません。このアプリはカーネル拡張を使いません。ヘルパーは NFS／ユーザ空間 FUSE を優先します。kext を入れないでください。\n\n%@"
          }
        }
      }
    },
