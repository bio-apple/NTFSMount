        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已挂载（只读）：Windows 休眠或卷不干净，请先在 Windows 彻底关机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
