    "helper.statusLegacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy sudo rules are still present. Update the helper to switch to signature pinning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有旧版 sudo 规则，请更新助手以换成签名钉扎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有舊版 sudo 規則，請更新助手以換成簽名釘扎。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧来の sudo 規則が残っています。署名ピン留めに切り替えるためヘルパーを更新してください。"
          }
        }
      }
    },
    "helper.statusOK": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed. Privileged calls go through the daemon, which verifies this app’s signature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装。特权调用经守护进程校验本应用签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝。特權呼叫經守護程式校驗本 App 簽名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みです。特権呼び出しはデーモンがこのアプリの署名を検証します。"
          }
        }
      }
    },
    "helper.hintNotarized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notarized: prefers system service authorization; falls back to an administrator password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已公证：优先用系统服务授权；失败再输入管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已公證：優先用系統服務授權；失敗再輸入管理員密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公証済み：システムサービスの承認を優先し、失敗時は管理者パスワードを求めます。"
          }
        }
      }
    },
    "helper.hintAdHoc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Un-notarized builds cannot use system services reliably, so installing the helper asks for an administrator password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未公证包无法稳定使用系统服务，安装助手会请求管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未公證套件無法穩定使用系統服務，安裝助手會要求管理員密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未公証パッケージではシステムサービスを安定して使えないため、ヘルパーのインストールで管理者パスワードが必要です。"
          }
        }
      }
    },
    "helper.privilegeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mount helper runs as root and can mount, unmount, and format external disks. The administrator password is used only for one-time install and is not saved. The Unix socket is mode 0666 so this app can connect as a normal user; the daemon checks the caller against the CDHash written at install time and only runs the root-owned helper copy under /Library/Application Support/NTFSMount/. It does not write sudoers. Uninstall: “Uninstall Helper” above, or uninstall.sh in the repo. Logs are at ~/Library/Logs/ntfsmount.log and remain on this Mac after uninstall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载助手以 root 运行，可以挂载、卸载、格式化外置盘。管理员密码只用于一次性安装，不会保存。Unix socket 权限为 0666，便于本应用以普通用户连接；守护进程用安装时写入的 CDHash 校验调用方，并只执行 /Library/Application Support/NTFSMount/ 下 root 所有的助手副本。不写 sudoers。卸载：上面的「卸载助手」，或仓库 uninstall.sh。日志在 ~/Library/Logs/ntfsmount.log，卸载后仍会留在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛載助手以 root 執行，可以掛載、卸載、格式化外接碟。管理員密碼只用於一次性安裝，不會儲存。Unix socket 權限為 0666，便於本 App 以一般使用者連線；守護程式用安裝時寫入的 CDHash 校驗呼叫方，並只執行 /Library/Application Support/NTFSMount/ 下 root 所有的助手副本。不寫 sudoers。解除安裝：上面的「解除安裝助手」，或倉庫 uninstall.sh。紀錄在 ~/Library/Logs/ntfsmount.log，解除安裝後仍會留在本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウントヘルパーは root で動作し、外付けディスクのマウント、アンマウント、フォーマットができます。管理者パスワードは一度きりのインストールにだけ使い、保存しません。Unix socket の権限は 0666 で、このアプリが一般ユーザとして接続できます。デーモンはインストール時に書いた CDHash で呼び出し元を検証し、/Library/Application Support/NTFSMount/ にある root 所有のヘルパーだけを実行します。sudoers は書きません。アンインストール：上の「ヘルパーをアンインストール」、またはリポジトリの uninstall.sh。ログは ~/Library/Logs/ntfsmount.log にあり、アンインストール後もこの Mac に残ります。"
          }
        }
      }
    },
    "alert.updateHelperTitle": {
