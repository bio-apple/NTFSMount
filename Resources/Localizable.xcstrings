    "forceUnmount.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not gracefully unmount “%@”. The disk may still be in use by Finder or another program. Force unmount can lose unsaved data or damage the volume.\nClose windows and files on this disk first. Force unmount anyway?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法优雅卸载「%@」。磁盘可能仍被访达或其他程序占用。强制卸载可能导致未写入的数据丢失或磁盘损坏。\n请先关闭该磁盘上的窗口和文件。确定仍要强制卸载吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法正常卸載「%@」。磁碟可能仍被 Finder 或其他程式占用。強制卸載可能導致未寫入的資料遺失或磁碟損壞。\n請先關閉該磁碟上的視窗和檔案。仍要強制卸載嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を通常アンマウントできませんでした。Finder や他のアプリが使用中の可能性があります。強制アンマウントは未書き込みデータの損失やディスク損傷の原因になります。\n先にこのディスクのウィンドウとファイルを閉じてください。それでも強制アンマウントしますか？"
          }
        }
      }
    },
    "forceUnmount.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force unmount “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制卸载「%@」？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制卸載「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を強制アンマウントしますか？"
          }
        }
      }
    },
