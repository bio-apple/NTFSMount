#!/bin/bash
# 仓库内 CLI。
#   ./scripts/ntfsmount diagnose [--json]
#   ./scripts/ntfsmount list|status|mount|unmount [--json] [diskNsM]
set -euo pipefail
DIR="$(cd "$(/usr/bin/dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
export NTFSMOUNT_ROOT="$ROOT"

usage() {
  cat <<EOF >&2
usage: ntfsmount <command> [--json] [diskNsM]
  diagnose           read-only environment report
  list               list NTFS volumes
  status [diskNsM]   mount status for one volume; omit ident to list
  mount diskNsM      mount read/write (needs root and an installed helper)
  unmount diskNsM    unmount (needs root and an installed helper)
--json prints stable English snake_case keys for a GUI or script.
EOF
}

JSON=0
POS=()
for a in "$@"; do
  case "$a" in
  --json) JSON=1 ;;
  -h | --help | help)
    usage
    exit 0
    ;;
  *) POS+=("$a") ;;
  esac
done

if [[ ${#POS[@]} -lt 1 ]]; then
  usage
  exit 2
fi
cmd="${POS[0]}"
device="${POS[1]:-}"

case "$cmd" in
diagnose)
  if [[ "$JSON" -eq 1 ]]; then
    exec "$DIR/ntfsmount-diagnose.sh" --json
  else
    exec "$DIR/ntfsmount-diagnose.sh"
  fi
  ;;
list | status | mount | unmount)
  # shellcheck source=ntfsmount-volumes.sh
  . "$DIR/ntfsmount-volumes.sh"
  case "$cmd" in
  list) cmd_list ;;
  status) cmd_status "$device" ;;
  mount) cmd_mount "$device" ;;
  unmount) cmd_unmount "$device" ;;
  esac
  ;;
*)
  echo "error: unknown subcommand: ${cmd}" >&2
  usage
  exit 2
  ;;
esac
