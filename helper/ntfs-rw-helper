refuse_eject_target() {
  local ident="$1"
  local whole="${ident%%s*}"
  local plist wplist internal winternal sys store i root_plist
  vlog "$DISKUTIL" info -plist "$ident"
  plist="$("$DISKUTIL" info -plist "$ident" 2>/dev/null || true)"
