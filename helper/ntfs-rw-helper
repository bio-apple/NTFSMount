  if valid_whole "$whole" && [[ "$whole" != "$ident" ]]; then
    wplist="$("$DISKUTIL" info -plist "$whole" 2>/dev/null || true)"
    winternal="$(printf '%s' "$wplist" | /usr/bin/plutil -extract Internal raw - 2>/dev/null || true)"
    if [[ "$winternal" == "true" ]]; then
      die "拒绝推出内置磁盘: $ident"
    fi
  fi
  vlog "$DISKUTIL" info -plist /
  root_plist="$("$DISKUTIL" info -plist / 2>/dev/null || true)"
  sys="$(printf '%s' "$root_plist" | /usr/bin/plutil -extract ParentWholeDisk raw - 2>/dev/null || true)"
  if [[ -n "$sys" && ( "$ident" == "$sys" || "$whole" == "$sys" || "$ident" == "${sys%%s*}" ) ]]; then
    die "拒绝推出系统盘: $ident"
  fi
