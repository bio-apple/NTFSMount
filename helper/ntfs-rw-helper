    [[ -n "$store" && "$store" != "null" ]] || break
    if [[ "$ident" == "$store" || "$whole" == "$store" || "$ident" == "${store%%s*}" || "$whole" == "${store%%s*}" ]]; then
      die "拒绝推出系统盘: $ident"
    fi
    i=$((i + 1))
  done
}

sanitize_label() {
  local label="$1"
  label="$(printf '%s' "$label" | /usr/bin/tr -d '/`\\;')"
  label="${label#"${label%%[![:space:]]*}"}"
  label="${label%"${label##*[![:space:]]}"}"
  if [[ ${#label} -gt 32 ]]; then
    label="${label:0:32}"
  fi
  [[ -n "$label" ]] || label="NTFS"
  printf '%s' "$label"
}

do_format() {
  local ident="$1"
  local label
  CURRENT_IDENT="$ident"
  valid_whole "$ident" || die "非法设备: ${ident}（格式化需要整个磁盘，例如 disk4）"
  refuse_format_target "$ident"
  [[ -e "/dev/$ident" ]] || die "设备不存在: /dev/$ident"
  [[ -n "$MKNTFS" && -x "$MKNTFS" ]] || die "找不到捆绑的 mkntfs。请把 NTFSMount.app 重新装到 /Applications"
  [[ -n "$NTFS3G_DIR" && -f "${NTFS3G_DIR}/libntfs-3g.90.dylib" ]] || die "找不到捆绑的 libntfs-3g。请把 NTFSMount.app 重新装到 /Applications"
  label="$(sanitize_label "${2:-NTFS}")"

  export PATH="${NTFS3G_DIR}:/usr/bin:/bin:/usr/sbin:/sbin"
  kill_ntfs3g_whole "$ident"
  vlog "$DISKUTIL" unmountDisk "$ident"
  if ! "$DISKUTIL" unmountDisk "$ident" >/dev/null 2>&1; then
    log_force_warning "$ident" "format unmountDisk after user confirm"
    vlog "$DISKUTIL" unmountDisk force "$ident"
    "$DISKUTIL" unmountDisk force "$ident" >/dev/null 2>&1 || true
  fi

  local out rc part dev
  set +e
  vlog "$DISKUTIL" eraseDisk ExFAT _NTFSFMT "$ident"
  out="$("$DISKUTIL" eraseDisk ExFAT _NTFSFMT "$ident" 2>&1)"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || die "分区失败: $out"

  vlog "$DISKUTIL" unmountDisk "$ident"
  if ! "$DISKUTIL" unmountDisk "$ident" >/dev/null 2>&1; then
    log_force_warning "$ident" "format unmountDisk before mkntfs"
    vlog "$DISKUTIL" unmountDisk force "$ident"
    "$DISKUTIL" unmountDisk force "$ident" >/dev/null 2>&1 || true
  fi
  part="$(data_partition "$ident")"
  valid_id "$part" || die "找不到数据分区: $ident"
  # macOS /dev/rdisk* is a character device; mkntfs needs a block device.
  dev="/dev/$part"
  [[ -b "$dev" ]] || die "不是块设备: $dev"

  set +e
  vlog "$MKNTFS" -F -Q -L "$label" "$dev"
  out="$("$MKNTFS" -F -Q -L "$label" "$dev" 2>&1)"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || die "mkntfs 失败: $out"
  /bin/sync
  # DiskArbitration 在探测前仍会报 ExFAT；先 mount 一次让系统认出 NTFS。
  vlog "$DISKUTIL" mount "$part"
  "$DISKUTIL" mount "$part" >/dev/null 2>&1 || true
  echo "ok formatted $part ($label)"
}

do_fix() {
  local ident="$1"
  CURRENT_IDENT="$ident"
  valid_id "$ident" || die "非法设备: $ident"
  refuse_fix_target "$ident"
  [[ -e "/dev/$ident" ]] || die "设备不存在: /dev/$ident"
  require_ntfs "$ident"
  [[ -n "$NTFSFIX" && -x "$NTFSFIX" ]] || die "找不到捆绑的 ntfsfix。请把 NTFSMount.app 重新装到 /Applications"
  [[ -n "$NTFS3G_DIR" && -f "${NTFS3G_DIR}/libntfs-3g.90.dylib" ]] || die "找不到捆绑的 libntfs-3g。请把 NTFSMount.app 重新装到 /Applications"

  export PATH="${NTFS3G_DIR}:/usr/bin:/bin:/usr/sbin:/sbin"
  ensure_unmounted "$ident"

  local probe out rc
  set +e
  vlog "$NTFSFIX" -n "/dev/$ident"
  probe="$("$NTFSFIX" -n "/dev/$ident" 2>&1)"
  set -e
  [[ -n "$probe" ]] && printf '%s\n' "$probe"
  if looks_like_hiber "$probe"; then
    echo "classify: Windows is hibernated"
    die "该卷处于 Windows 休眠（hiberfil）。不会运行 ntfsfix，以免破坏休眠数据。请在 Windows 彻底关机（不要休眠/快速启动）后再试。"
  fi

  # man ntfsfix: -d 在可修复时清除 dirty，以便挂载。不用 -d 反而会把 dirty 再标上。
  # 不清除 hiberfile（ntfsfix 也没有该选项；挂载路径同样不用 remove_hiberfile）。
  set +e
  vlog "$NTFSFIX" -d "/dev/$ident"
  out="$("$NTFSFIX" -d "/dev/$ident" 2>&1)"
  rc=$?
  set -e
  [[ -n "$out" ]] && printf '%s\n' "$out"
  [[ $rc -eq 0 ]] || die "ntfsfix 失败: $out"
  /bin/sync
  echo "classify: volume is dirty"
  echo "ok fixed $ident"
}

DAEMON_LABEL="com.bioapple.ntfsmount.automount"
DAEMON_PLIST="/Library/LaunchDaemons/${DAEMON_LABEL}.plist"
LEGACY_DAEMON_LABEL="local.ntfsmount.automount"

require_root() {
  [[ "$(/usr/bin/id -u)" -eq 0 ]] || die "需要 root"
}

is_ntfs() {
  local fs
  vlog "$DISKUTIL" info -plist "$1"
  fs="$("$DISKUTIL" info -plist "$1" 2>/dev/null | /usr/bin/plutil -extract FilesystemName raw - 2>/dev/null || true)"
  [[ "$fs" == "NTFS" ]]
}

# 系统只读刚插入：先卸掉 /Volumes/Name（及同盘 leftover Name 1），再可写重挂；dirty/休眠则只读。
# 未挂载的外置 NTFS 同样自动挂（Issue #1）。用户主动卸载的不自动再挂。已是本助手 fuse 则只清重复卷。
# 不自动 ntfsfix、不清除 hiberfile、不格式化、不碰内置盘。
helper_automount_should_run() {
  local internal="$1" our_fuse="$2" writable="$3"
  [[ "$internal" == 1 ]] && return 1
  [[ "$our_fuse" == 1 || "$writable" == 1 ]] && return 1
  return 0
}

do_automount() {
  local ident name mp our=0 wr=0 internal=0
  while IFS= read -r ident; do
    [[ -n "$ident" ]] || continue
    valid_id "$ident" || continue
    is_ntfs "$ident" || continue
    internal=0
    is_auto_safe_target "$ident" || internal=1
    name="$(volume_name "$ident")"
    if ! mp="$(plist_mount_point "$ident")"; then
      mp="$(volume_mount_point "$name")"
    fi
    our=0
    wr=0
    is_our_fuse_mount "$mp" && our=1
    is_writable_mount "$mp" && wr=1
    # 未挂载外置 NTFS（our=0, wr=0）也走 do_mount；不要用 volume_still_mounted 当唯一入口。
    if ! helper_automount_should_run "$internal" "$our" "$wr"; then
      if [[ "$internal" -eq 0 ]]; then
        unmount_numbered_leftovers "$ident" "$name"
      fi
      continue
    fi
    if ! writable_accepted; then
      echo "automount skip $ident (writable risk not accepted)" >&2
      continue
    fi
    CURRENT_IDENT="$ident"
    ( do_mount "$ident" ) || echo "automount skip $ident" >&2
  done < <(list_slice_idents)
  echo "ok automount"
}

installed_helper_path() {
  local sealed="/Library/Application Support/NTFSMount/ntfs-rw-helper"
  if [[ -x "$sealed" ]]; then
    printf '%s' "$sealed"
    return 0
  fi
  return 1
}

writable_accepted() {
  local user home stamp
  user="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || /usr/bin/id -un)"
  home="$(/usr/bin/dscl . -read "/Users/${user}" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}' || true)"
  stamp="${home}/Library/Application Support/com.bioapple.ntfsmount/writable-accepted"
  [[ -f "$stamp" ]]
}

do_enable_automount() {
  require_root
  local helper
  helper="$(installed_helper_path)" || die "请先安装挂载助手"
  "$LAUNCHCTL" bootout "system/${DAEMON_LABEL}" >/dev/null 2>&1 || true
  "$LAUNCHCTL" bootout "system/${LEGACY_DAEMON_LABEL}" >/dev/null 2>&1 || true
  /bin/rm -f "/Library/LaunchDaemons/${LEGACY_DAEMON_LABEL}.plist"
  /usr/bin/plutil -create xml1 "$DAEMON_PLIST"
  /usr/bin/plutil -insert Label -string "$DAEMON_LABEL" "$DAEMON_PLIST"
  /usr/bin/plutil -insert ProgramArguments -json "[\"${helper}\",\"automount\"]" "$DAEMON_PLIST"
  /usr/bin/plutil -insert WatchPaths -json "[\"/Volumes\"]" "$DAEMON_PLIST"
  /usr/bin/plutil -insert StartOnMount -bool true "$DAEMON_PLIST"
  /usr/bin/plutil -insert RunAtLoad -bool true "$DAEMON_PLIST"
  /usr/bin/plutil -insert ThrottleInterval -integer 5 "$DAEMON_PLIST"
  /usr/sbin/chown root:wheel "$DAEMON_PLIST"
  /bin/chmod 644 "$DAEMON_PLIST"
  "$LAUNCHCTL" bootstrap system "$DAEMON_PLIST" || die "launchctl bootstrap 失败"
  echo "ok automount enabled"
}

do_disable_automount() {
  require_root
  "$LAUNCHCTL" bootout "system/${DAEMON_LABEL}" >/dev/null 2>&1 || true
  "$LAUNCHCTL" bootout "system/${LEGACY_DAEMON_LABEL}" >/dev/null 2>&1 || true
  /bin/rm -f "$DAEMON_PLIST" "/Library/LaunchDaemons/${LEGACY_DAEMON_LABEL}.plist"
  echo "ok automount disabled"
}

# 本应用捆绑的 ntfs-3g / go-nfsv4（app bundle、sealed support、dev runtime）。
# 不匹配 Homebrew / 系统 FUSE-T / 其它 App。
is_ntfsmount_runtime_path() {
  local p="$1" dir macos nfs
  [[ -n "$p" && "$p" == /* ]] || return 1
  case "$p" in
    *"/NTFSMount.app/Contents/MacOS/ntfs-3g"|*"/NTFSMount.app/Contents/MacOS/go-nfsv4") return 0 ;;
  esac
  if [[ "$p" == "/Library/Application Support/NTFSMount" ||
        "$p" == "/Library/Application Support/NTFSMount/"* ]]; then
    return 0
  fi
  if [[ -n "$NTFS3G" && "$p" == "$NTFS3G" ]]; then
    return 0
  fi
  nfs="$(resolve_nfs_srv || true)"
  if [[ -n "$nfs" && "$p" == "$nfs" ]]; then
    return 0
  fi
  if [[ -n "$NTFS3G_DIR" ]]; then
    if [[ "$p" == "${NTFS3G_DIR}/ntfs-3g" || "$p" == "${NTFS3G_DIR}/go-nfsv4" ]]; then
      return 0
    fi
  fi
  for dir in "${BUNDLE_DIRS[@]+"${BUNDLE_DIRS[@]}"}"; do
    if [[ "$p" == "${dir}/ntfs-3g" || "$p" == "${dir}/go-nfsv4" ]]; then
      return 0
    fi
  done
  macos="$(installed_app_macos || true)"
  if [[ -n "$macos" ]]; then
    if [[ "$p" == "${macos}/ntfs-3g" || "$p" == "${macos}/go-nfsv4" ]]; then
      return 0
    fi
  fi
  return 1
}

installed_app_macos() {
  local f="/Library/Application Support/NTFSMount/app.path" app
  [[ -f "$f" ]] || return 1
  app="$(/bin/cat "$f" 2>/dev/null || true)"
  app="${app%%$'\n'*}"
  [[ -n "$app" && -d "${app}/Contents/MacOS" ]] || return 1
  printf '%s' "${app}/Contents/MacOS"
}

is_repair_mount_point() {
  local mp="$1"
  [[ "$mp" == /Volumes/* ]] || return 1
  [[ "$mp" != "/Volumes" ]] || return 1
  [[ "$mp" != "/" ]] || return 1
  [[ "$mp" != /System/* && "$mp" != /Users/* && "$mp" != /private/* ]] || return 1
  return 0
}

is_localhost_nfs_source() {
  local src="$1"
  [[ -n "$src" ]] || return 1
  if [[ "$src" == 127.0.0.1:* || "$src" == localhost:* ||
        "$src" == "::1:"* || "$src" == "[::1]:"* ||
        "$src" == "nfs://127.0.0.1/"* || "$src" == "nfs://localhost/"* ]]; then
    return 0
  fi
  return 1
}

line_looks_like_our_backend() {
  local line="$1"
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line" | /usr/bin/grep -qiE 'ntfs-3g|fuse-t|fuset| \(nfs,|\(nfs,'
}

is_localhost_nfs_line() {
  local line="$1" src
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line" | /usr/bin/grep -qiE ' \(nfs,|\(nfs,' || return 1
  src="$(printf '%s\n' "$line" | /usr/bin/awk '{ print $1 }')"
  is_localhost_nfs_source "$src"
}

pid_exe_path() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  "$LSOF" -p "$pid" -a -d txt -Fn 2>/dev/null | /usr/bin/awk '/^n\// { print substr($0, 2); exit }'
}

list_candidate_fuse_procs() {
  {
    "$PGREP" -lf -- ntfs-3g 2>/dev/null || true
    "$PGREP" -lf -- go-nfsv4 2>/dev/null || true
  } | /usr/bin/awk 'NF >= 2 && $1 ~ /^[0-9]+$/ && !seen[$1]++ { print }'
}

proc_is_our_fuse() {
  local cmd="$1" exe="$2"
  printf '%s' "$cmd" | /usr/bin/grep -qiE 'ntfs-3g|go-nfsv4' || return 1
  printf '%s' "$cmd" | /usr/bin/grep -qiE 'ntfs-rw-helper|ntfsmount-helperd' && return 1
  if is_ntfsmount_runtime_path "$exe"; then
    return 0
  fi
  is_ntfsmount_runtime_path "${cmd%% *}"
}

our_fuse_pids_for_ident() {
  local ident="$1" name="$2"
  local needle qname pid cmd exe
  needle="$(ntfs3g_pkill_needle "$ident")"
  qname="$(regex_escape "$name")"
  while IFS= read -r pid cmd; do
    [[ -n "$pid" ]] || continue
    exe="$(pid_exe_path "$pid" || true)"
    proc_is_our_fuse "$cmd" "$exe" || continue
    if printf '%s' "$cmd" | /usr/bin/grep -qE -- "$needle"; then
      printf '%s\n' "$pid"
      continue
    fi
    if [[ -n "$qname" ]] && printf '%s' "$cmd" | /usr/bin/grep -qE -- "go-nfsv4 .*--volname ${qname}( |$)"; then
      printf '%s\n' "$pid"
      continue
    fi
    if [[ -n "$qname" ]] && printf '%s' "$cmd" | /usr/bin/grep -qE -- "go-nfsv4 .* /Volumes/${qname}( |$)"; then
      printf '%s\n' "$pid"
    fi
  done < <(list_candidate_fuse_procs)
}

has_foreign_fuse_pid_for_ident() {
  local ident="$1" needle pid cmd exe
  needle="$(ntfs3g_pkill_needle "$ident")"
  while IFS= read -r pid cmd; do
    [[ -n "$pid" ]] || continue
    printf '%s' "$cmd" | /usr/bin/grep -qE -- "$needle" || continue
    exe="$(pid_exe_path "$pid" || true)"
    if proc_is_our_fuse "$cmd" "$exe"; then
      continue
    fi
    if printf '%s' "$cmd" | /usr/bin/grep -qiE 'ntfs-3g|go-nfsv4'; then
      return 0
    fi
  done < <(list_candidate_fuse_procs)
  return 1
}

repair_has_numbered_leftover() {
  local ident="$1" name="$2" n mp line
  for n in 1 2 3; do
    mp="$(volume_mount_point "$name" "$n")"
    line="$(mount_line "$mp")"
    [[ -n "$line" ]] || continue
    case "$line" in
      "/dev/${ident} on "*) return 0 ;;
    esac
    is_localhost_nfs_line "$line" && return 0
  done
  return 1
}

repair_should_unmount_ident() {
  local ident="$1" mp="$2" name="$3" line
  if [[ -n "$(our_fuse_pids_for_ident "$ident" "$name")" ]]; then
    return 0
  fi
  if has_foreign_fuse_pid_for_ident "$ident"; then
    return 1
  fi
  line="$(mount_line "$mp")"
  if [[ -n "$line" ]] && line_looks_like_our_backend "$line"; then
    return 0
  fi
  repair_has_numbered_leftover "$ident" "$name"
}

# 优雅卸载；不 kill、不 ALLOW_FORCE、不 umount -f。占用则失败给 UI。
repair_graceful_unmount_ident() {
  local ident="$1" mp="$2" name="$3" extra
  try_unmount_target "$mp" || true
  try_unmount_target "$ident" || true
  try_unmount_target "/dev/$ident" || true
  while IFS= read -r extra; do
    [[ -n "$extra" ]] || continue
    try_unmount_target "$extra" || true
  done < <(dev_mount_points "$ident")
  unmount_numbered_leftovers "$ident" "$name"
  try_unmount_target "$mp" || true
  if volume_still_mounted "$ident" || repair_has_numbered_leftover "$ident" "$name"; then
    return 1
  fi
  return 0
}

repair_unmount_orphan_localhost_nfs() {
  local line src mp n=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    is_localhost_nfs_line "$line" || continue
    src="$(printf '%s\n' "$line" | /usr/bin/awk '{ print $1 }')"
    mp="$(repair_mp_from_line "$line")"
    is_repair_mount_point "$mp" || continue
    if ! our_pid_owns_mount "$mp" "$line"; then
      continue
    fi
    try_unmount_target "$mp" || true
    if [[ -z "$(mount_line "$mp")" ]]; then
      n=$((n + 1))
    fi
  done < <("$MOUNT")
  printf '%s' "$n"
}

repair_mp_from_line() {
  local line="$1"
  printf '%s\n' "$line" | /usr/bin/awk '
    $2 == "on" {
      mp = ""
      for (i = 3; i <= NF; i++) {
        if ($i ~ /^\(/) break
        mp = (mp == "" ? $i : mp " " $i)
      }
      if (mp != "") print mp
      exit
    }'
}

our_pid_owns_mount() {
  local mp="$1" line="$2" pid cmd exe
  while IFS= read -r pid cmd; do
    [[ -n "$pid" ]] || continue
    exe="$(pid_exe_path "$pid" || true)"
    proc_is_our_fuse "$cmd" "$exe" || continue
    if printf '%s' "$cmd" | /usr/bin/grep -F -q -- "$mp"; then
      return 0
    fi
  done < <(list_candidate_fuse_procs)
  return 1
}

list_our_fuse_pids() {
  local pid cmd exe
  while IFS= read -r pid cmd; do
    [[ -n "$pid" ]] || continue
    [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
    exe="$(pid_exe_path "$pid" || true)"
    proc_is_our_fuse "$cmd" "$exe" || continue
    printf '%s\n' "$pid"
  done < <(list_candidate_fuse_procs)
}

kill_our_pid() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$pid" == "$$" || "$pid" == "$PPID" || "$pid" == "1" ]] && return 1
  "$KILL" -TERM "$pid" >/dev/null 2>&1 || true
  sleep 0.2
  if /bin/kill -0 "$pid" 2>/dev/null; then
    "$KILL" -KILL "$pid" >/dev/null 2>&1 || true
  fi
}

# 一键修复：只清理本应用的残留 FUSE/NFS 挂载与捆绑 ntfs-3g/go-nfsv4 进程。
# 不重置 pf、不碰 vmnet、不 umount -f、不 diskutil unmount force、不修盘、不清 hiberfile。
do_repair_env() {
  CURRENT_IDENT="-"
  CURRENT_CMD="repair-env"
  local unmounted=0 killed=0 busy=0
  local ident mp name skip=":"
  local pid nfs_n

  while IFS= read -r ident; do
    [[ -n "$ident" ]] || continue
    valid_id "$ident" || continue
    is_ntfs "$ident" || continue
    name="$(volume_name "$ident")"
    if ! mp="$(plist_mount_point "$ident")"; then
      mp="$(volume_mount_point "$name")"
    fi
    if ! repair_should_unmount_ident "$ident" "$mp" "$name"; then
      continue
    fi
    if repair_graceful_unmount_ident "$ident" "$mp" "$name"; then
      unmounted=$((unmounted + 1))
      log_event "$ident" "repair-env-unmount" "0" "0"
    else
      busy=$((busy + 1))
      echo "busy ${ident}" >&2
      log_event "$ident" "repair-env-busy" "1" "0"
      while IFS= read -r pid; do
        [[ -n "$pid" ]] || continue
        skip="${skip}${pid}:"
      done < <(our_fuse_pids_for_ident "$ident" "$name")
    fi
  done < <(list_slice_idents)

  nfs_n="$(repair_unmount_orphan_localhost_nfs)"
  [[ "$nfs_n" =~ ^[0-9]+$ ]] || nfs_n=0
  unmounted=$((unmounted + nfs_n))

  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    printf '%s' "$skip" | /usr/bin/grep -q ":${pid}:" && continue
    kill_our_pid "$pid"
    killed=$((killed + 1))
    log_event "-" "repair-env-kill-${pid}" "0" "0"
  done < <(list_our_fuse_pids)

  echo "ok repair-env unmounted=${unmounted} killed=${killed} busy=${busy}"
}

do_selftest() {
  if ! valid_id disk12s1; then
    die "selftest: disk12s1 应为合法"
  fi
  if valid_id "disk12s1;whoami"; then
    die "selftest: 注入 id 应拒绝"
  fi
  if valid_id "disk 12s1"; then
    die "selftest: 空白 id 应拒绝"
  fi
  if ! valid_whole disk12; then
    die "selftest: disk12 应为合法整盘"
  fi
  if valid_whole disk12s1; then
    die "selftest: 分区不应当作整盘"
  fi
  if valid_id '../disk1s1'; then
    die "selftest: 路径 id 应拒绝"
  fi
  if valid_id 'disk5s1$(whoami)'; then
    die "selftest: 命令替换 id 应拒绝"
  fi
  if valid_id 'disk5s1;whoami'; then
    die "selftest: 分号 id 应拒绝"
  fi
  if valid_whole 'disk4;id'; then
    die "selftest: 整盘注入应拒绝"
  fi
  local mp name needle sample got
  name="My Passport"
  mp="$(volume_mount_point "$name")"
  [[ "$mp" == "/Volumes/My Passport" ]] || die "selftest: 带空格卷名应为单一挂载点"
  name="Seagate Expansion"
  mp="$(volume_mount_point "$name")"
  [[ "$mp" == "/Volumes/Seagate Expansion" ]] || die "selftest: Seagate Expansion 应为单一挂载点"
  mp="$(volume_mount_point "$name" 1)"
  [[ "$mp" == "/Volumes/Seagate Expansion 1" ]] || die "selftest: leftover 挂载点应保留空格"
  name="移动硬盘"
  mp="$(volume_mount_point "$name")"
  [[ "$mp" == "/Volumes/移动硬盘" ]] || die "selftest: 中文卷名应为单一挂载点"
  mp="$(volume_mount_point "$name" 1)"
  [[ "$mp" == "/Volumes/移动硬盘 1" ]] || die "selftest: 中文 leftover 挂载点应保留空格"
  [[ "$(fuse_opt_escape '移动,硬盘')" == '移动\,硬盘' ]] || die "selftest: CJK 卷名逗号应转义"
  [[ "${ALLOW_FORCE}" -eq 0 ]] || die "selftest: ALLOW_FORCE 默认必须为 0"
  [[ "$(fuse_opt_escape 'Seagate, Expansion')" == 'Seagate\, Expansion' ]] || die "selftest: FUSE volname 逗号应转义"
  got="$(NTFS_LOCALE=zh_CN.UTF-8 ntfs3g_base_opts 'Seagate\, Expansion' 501 20)"
  [[ "$got" == *'volname=Seagate\, Expansion'* ]] || die "selftest: base 须含 volname"
  [[ "$got" == *',local,'* ]] || die "selftest: base 须含 local"
  [[ "$got" == *',allow_other,'* ]] || die "selftest: base 须含 allow_other"
  [[ "$got" == *',auto_xattr,'* ]] || die "selftest: base 须含 auto_xattr"
  [[ "$got" == *',uid=501,gid=20,'* ]] || die "selftest: base 须把卷属主设为登录用户"
  [[ "$got" == *',locale=zh_CN.UTF-8' ]] || die "selftest: base 须含 UTF-8 locale"
  sample='   1: Windows_NTFS Seagate Expansion     1.0 TB     disk7s1'
  got="$(printf '%s\n' "$sample" | /usr/bin/awk '/Windows_NTFS/ && $NF ~ /^disk[0-9]+s[0-9]+$/ { print $NF }')"
  [[ "$got" == disk7s1 ]] || die "selftest: diskutil list 末字段在卷名有空格时仍是 diskNsM"
  [[ "$(regex_escape 'Data (1)')" == 'Data \(1\)' ]] || die "selftest: pkill 卷名应转义正则"
  needle="$(ntfs3g_pkill_needle disk4)"
  [[ "$needle" == "ntfs-3g /dev/disk4 " ]] || die "selftest: pkill needle 须带尾随空格"
  sample="ntfs-3g /dev/disk4 /Volumes/X"
  printf '%s' "$sample" | /usr/bin/grep -qE -- "$needle" || die "selftest: disk4 应匹配自身"
  sample="ntfs-3g /dev/disk40 /Volumes/Y"
  if printf '%s' "$sample" | /usr/bin/grep -qE -- "$needle"; then
    die "selftest: disk4 不得匹配 disk40"
  fi
  sample="ntfs-3g /dev/disk4s1 /Volumes/Z"
  if printf '%s' "$sample" | /usr/bin/grep -qE -- "$needle"; then
    die "selftest: disk4 不得匹配 disk4s1"
  fi
  helper_automount_should_run 0 0 0 || die "selftest: 未挂载外置应自动挂"
  if helper_automount_should_run 0 1 0; then
    die "selftest: 已是本助手 fuse 应跳过"
  fi
  if helper_automount_should_run 0 0 1; then
    die "selftest: 已可写应跳过"
  fi
  if helper_automount_should_run 1 0 0; then
    die "selftest: 内置盘不得自动挂"
  fi
  [[ "$(volume_state_from_text 'Volume is dirty. Please run chkdsk.')" == dirty ]] || die "selftest: dirty 分类"
  [[ "$(volume_state_from_text 'Windows is hibernated, refused to mount.')" == hiber ]] || die "selftest: hiber 分类"
  [[ "$(volume_state_from_text 'NTFS volume may be corrupted')" == corrupt ]] || die "selftest: corrupt 分类"
  [[ "$(volume_state_from_text 'NTFS partition /dev/disk4s1 was processed successfully.')" == clean ]] || die "selftest: clean 分类"
  [[ "$(volume_state_from_text 'Volume is dirty. Windows is hibernated.')" == hiber ]] || die "selftest: hiber 优先于 dirty"
  [[ "$(classify_line_for_state dirty)" == "classify: volume is dirty" ]] || die "selftest: dirty classify 行"
  [[ "$(classify_line_for_state corrupt)" == "classify: volume may be corrupted" ]] || die "selftest: corrupt classify 行"
  is_ntfsmount_runtime_path "/Applications/NTFSMount.app/Contents/MacOS/ntfs-3g" || die "selftest: bundle ntfs-3g 应算本应用"
  is_ntfsmount_runtime_path "/Applications/NTFSMount.app/Contents/MacOS/go-nfsv4" || die "selftest: bundle go-nfsv4 应算本应用"
  is_ntfsmount_runtime_path "/Library/Application Support/NTFSMount/ntfs-rw-helper" || die "selftest: sealed helper 路径应算本应用"
  if is_ntfsmount_runtime_path "/usr/local/bin/ntfs-3g"; then
    die "selftest: Homebrew ntfs-3g 不得算本应用"
  fi
  if is_ntfsmount_runtime_path "/opt/homebrew/bin/ntfs-3g"; then
    die "selftest: Homebrew ntfs-3g 不得算本应用"
  fi
  if is_ntfsmount_runtime_path "/Library/Application Support/fuse-t/bin/go-nfsv4"; then
    die "selftest: 系统 FUSE-T go-nfsv4 不得算本应用"
  fi
  is_localhost_nfs_source "127.0.0.1:/vol" || die "selftest: 127.0.0.1 NFS 应识别"
  is_localhost_nfs_source "localhost:/vol" || die "selftest: localhost NFS 应识别"
  if is_localhost_nfs_source "fileserver.local:/share"; then
    die "selftest: 远程 NFS 不得当作本机残留"
  fi
  if is_localhost_nfs_source "192.168.1.5:/export"; then
    die "selftest: 局域网 NFS 不得当作本机残留"
  fi
  is_repair_mount_point "/Volumes/My Passport" || die "selftest: /Volumes 挂载点应允许"
  if is_repair_mount_point "/"; then
    die "selftest: 根目录不得卸载"
  fi
  if is_repair_mount_point "/System/Volumes/Data"; then
    die "selftest: 系统卷不得卸载"
  fi
  if is_repair_mount_point "/Users/name"; then
    die "selftest: 用户目录不得卸载"
  fi
  is_localhost_nfs_line "127.0.0.1:/abc on /Volumes/Foo (nfs, nodev, nosuid)" || die "selftest: FUSE-T NFS 行应识别"
  [[ "${ALLOW_FORCE}" -eq 0 ]] || die "selftest: repair 路径后 ALLOW_FORCE 仍须为 0"
  echo "ok selftest HELPER_VERSION=${HELPER_VERSION}"
}

usage() {
  cat <<'EOF'
用法: ntfs-rw-helper [--verbose] <mount|unmount|eject|format|fix|probe|automount|enable-automount|disable-automount|repair-env|version|selftest> [diskNsM|diskN] [label|force]
  示例: ntfs-rw-helper mount disk5s1
      ntfs-rw-helper --verbose mount disk5s1
      ntfs-rw-helper probe disk5s1
      ntfs-rw-helper unmount disk5s1
      ntfs-rw-helper unmount disk5s1 force
      ntfs-rw-helper fix disk5s1
      ntfs-rw-helper format disk4 DATA
      ntfs-rw-helper enable-automount
      ntfs-rw-helper repair-env
EOF
}

POS=()
for a in "$@"; do
  case "$a" in
    --verbose|-v) VERBOSE=1 ;;
    *) POS+=("$a") ;;
  esac
done

cmd="${POS[0]:-}"
id="${POS[1]:-}"
CURRENT_CMD="${cmd:--}"
CURRENT_IDENT="${id:--}"
[[ "$CURRENT_IDENT" == "--verbose" || "$CURRENT_IDENT" == "-v" ]] && CURRENT_IDENT="-"

init_log_file
rotate_log_if_needed "$LOG_FILE"
CMD_START_MS="$(now_ms)"
trap on_exit EXIT

case "$cmd" in
  mount) do_mount "$id" ;;
  unmount) do_unmount "$id" "${POS[2]:-}" ;;
  eject) do_eject "$id" ;;
  format) do_format "$id" "${POS[2]:-NTFS}" ;;
  fix|ntfsfix) do_fix "$id" ;;
  probe) do_probe "$id" ;;
  automount) do_automount ;;
  enable-automount) do_enable_automount ;;
  disable-automount) do_disable_automount ;;
  repair-env) do_repair_env ;;
  version) echo "HELPER_VERSION=${HELPER_VERSION}" ;;
  selftest) do_selftest ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
